# Copy this file to .env and adjust as needed
# Use the Vite proxy in development to avoid browser CORS errors.
VITE_API_BASE_URL=/api/v1
# Change this if your local backend runs elsewhere.
VITE_DEV_API_TARGET=http://localhost:8080

# Polling interval (ms) for the "realtime" users list refresh
VITE_POLL_INTERVAL=5000
